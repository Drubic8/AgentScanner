# 1. Игнорировать абсолютно всё в репозитории
*

# 2. Разрешить Git сканировать папки
!*/

# 3. ГЛОБАЛЬНЫЙ ЗАПРЕТ на мусорные файлы и папки (Важно: без слэша на конце для .pyc)
__pycache__/
*.pyc
*.pyo
*.pyd
debug/
export_pdf/
Архив/
Сборка/
книга/
cloud_platform/
.venv/
.vscode/
fms_agent/
plans/
soft_other/
MobileApp/
docs/pyasic_docs/

# 4. РАЗРЕШИТЬ конкретные файлы в корне проекта
!gemini_gui.py
!.gitignore
!version.json
!README.md
!LICENSE
!requirements.txt

# 5. РАЗРЕШИТЬ python-файлы внутри рабочей папки (но не кэш)
!miner_scanner/**/*.py

# 6. РАЗРЕШИТЬ папку с документацией
!docs/**

# Scanner package metadata, profiles and reproducible checks
!pyproject.toml
!miner_scanner/profiles/*.json
!tests/**/*.py
!tests/fixtures/**/*.json
!scripts/check_scanner.py
!scripts/benchmark_scanner.py
*.egg-info/
build/
build-clean/
dist/
.venv-new/

# Windows desktop and release tooling
!desktop_ui/**/*.py
!app.ico
!ASIC_Monitor.spec
!scripts/build_windows.py
!requirements-build.lock
!.github/workflows/windows-build.yml
.venv-build/
build-windows/
artifacts/

# Local references and diagnostic bundles must not be published.
docs/pyasic_docs/
diagnostics/
outputs/

# Public contributor guides and repository automation (explicit allowlist).
!/CONTRIBUTING.md
!/SECURITY.md
!/CHANGELOG.md
!/ROADMAP.md
!.github/PULL_REQUEST_TEMPLATE.md
!.github/ISSUE_TEMPLATE/*.yml
!.github/workflows/tests.yml

# Android source and reproducible build inputs only.
!apps/android/**/*.kts
!apps/android/**/*.kt
!apps/android/**/*.py
!apps/android/**/*.xml
!apps/android/**/*.properties
!apps/android/**/*.txt
!apps/android/**/*.md
!apps/android/gradlew
!apps/android/gradlew.bat
!apps/android/gradle/wrapper/gradle-wrapper.jar
!.github/workflows/android.yml
apps/android/**/build/
apps/android/.gradle/
apps/android/.kotlin/
apps/android/**/local.properties
apps/android/**/*.jks
apps/android/**/*.keystore
apps/android/**/__pycache__/
