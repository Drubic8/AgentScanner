    {
      "id": "bitmain.stock.l9.20250210",
      "version": 1,
      "make": "Bitmain",
      "firmware": "Stock",
      "signature": "antminer",
      "priority": 20,
      "parser": "antminer",
      "control": "antminer",
      "match": {
        "models": ["Antminer L9"],
        "firmware_versions": ["Mon Feb 10 10:01:06 CST 2025"],
        "api_versions": ["3.1"]
      },
      "queries": [
        ["version", "cgminer", "version", true],
        ["stats", "cgminer", "stats", false, {"repair": "antminer_stats"}],
        ["summary", "cgminer", "summary", false],
        ["pools", "cgminer", "pools", true],
        ["system", "http", "/cgi-bin/get_system_info.cgi", true],
        ["config", "http", "/cgi-bin/get_miner_conf.cgi", false],
        ["warnings", "text", "/warning", true, {"port": 6060}]
      ],
      "verified_commands": ["mining_start", "identify_on", "identify_off"],
      "command_rules": {
        "identify_on": {
          "path": "/cgi-bin/blink.cgi",
          "method": "POST",
          "payload": {"blink": true},
          "verify": {"path": "/cgi-bin/get_blink_status.cgi", "field": ["blink"], "equals": true}
        },
        "identify_off": {
          "path": "/cgi-bin/blink.cgi",
          "method": "POST",
          "payload": {"blink": false},
          "success_codes": ["B000", "B100"],
          "verify": {"path": "/cgi-bin/get_blink_status.cgi", "field": ["blink"], "equals": false}
        },
        "mining_start": {
          "path": "/cgi-bin/set_miner_conf.cgi",
          "method": "POST",
          "read_config": "/cgi-bin/get_miner_conf.cgi",
          "config_fields": {
            "pools": "pools",
            "bitmain-fan-ctrl": "bitmain-fan-ctrl",
            "bitmain-fan-pwm": "bitmain-fan-pwm",
            "freq-level": "bitmain-freq-level"
          },
          "payload": {"miner-mode": 0},
          "verify": {"path": "/cgi-bin/get_miner_conf.cgi", "field": ["bitmain-work-mode"], "equals": "0"}
        }
      }
    },
    {
      "id": "bitmain.stock.t21.20250116",
      "version": 1,
      "make": "Bitmain",
      "firmware": "Stock",
      "signature": "antminer",
      "priority": 20,
      "parser": "antminer",
      "control": "antminer",
      "match": {"models": ["Antminer T21"], "firmware_versions": ["Thu Jan 16 11:00:25 CST 2025"], "api_versions": ["3.1"]},
      "queries": [
        ["version", "cgminer", "version", true],
        ["stats", "cgminer", "stats", false, {"repair": "antminer_stats"}],
        ["summary", "cgminer", "summary", false],
        ["pools", "cgminer", "pools", true],
        ["system", "http", "/cgi-bin/get_system_info.cgi", true],
        ["config", "http", "/cgi-bin/get_miner_conf.cgi", false],
        ["warnings", "text", "/warning", true, {"port": 6060}]
      ],
      "verified_commands": ["identify_on", "identify_off", "reboot", "mining_stop", "mining_start", "hem", "normal_power"],
      "command_rules": {
        "identify_on": {
          "path": "/cgi-bin/blink.cgi", "method": "POST", "payload": {"blink": true},
          "verify": {"path": "/cgi-bin/get_blink_status.cgi", "field": ["blink"], "equals": true}
        },
        "identify_off": {
          "path": "/cgi-bin/blink.cgi", "method": "POST", "payload": {"blink": false},
          "success_codes": ["B000", "B100"],
          "verify": {"path": "/cgi-bin/get_blink_status.cgi", "field": ["blink"], "equals": false}
        },
        "mining_stop": {
          "path": "/cgi-bin/set_miner_conf.cgi", "method": "POST",
          "success_codes": ["B000", "M000"],
          "read_config": "/cgi-bin/get_miner_conf.cgi",
          "config_fields": {"pools": "pools", "bitmain-fan-ctrl": "bitmain-fan-ctrl", "bitmain-fan-pwm": "bitmain-fan-pwm", "bitmain-hashrate-percent": "bitmain-hashrate-percent", "bitmain-user-ip-cat": "bitmain-user-ip-cat"},
          "payload": {"miner-mode": 1},
          "verify": {"path": "/cgi-bin/get_miner_conf.cgi", "field": ["bitmain-work-mode"], "equals": "1"}
        },
        "mining_start": {
          "path": "/cgi-bin/set_miner_conf.cgi", "method": "POST",
          "success_codes": ["B000", "M000"],
          "read_config": "/cgi-bin/get_miner_conf.cgi",
          "config_fields": {"pools": "pools", "bitmain-fan-ctrl": "bitmain-fan-ctrl", "bitmain-fan-pwm": "bitmain-fan-pwm", "bitmain-hashrate-percent": "bitmain-hashrate-percent", "bitmain-user-ip-cat": "bitmain-user-ip-cat"},
          "payload": {"miner-mode": 0},
          "verify": {"path": "/cgi-bin/get_miner_conf.cgi", "field": ["bitmain-work-mode"], "equals": "0"}
        },
        "hem": {
          "path": "/cgi-bin/set_miner_conf.cgi", "method": "POST",
          "success_codes": ["B000", "M000"],
          "read_config": "/cgi-bin/get_miner_conf.cgi",
          "config_fields": {"pools": "pools", "bitmain-fan-ctrl": "bitmain-fan-ctrl", "bitmain-fan-pwm": "bitmain-fan-pwm", "bitmain-hashrate-percent": "bitmain-hashrate-percent", "bitmain-user-ip-cat": "bitmain-user-ip-cat"},
          "payload": {"miner-mode": 2},
          "verify": {"path": "/cgi-bin/get_miner_conf.cgi", "field": ["bitmain-work-mode"], "equals": "2"}
        },
        "normal_power": {
          "path": "/cgi-bin/set_miner_conf.cgi", "method": "POST",
          "success_codes": ["B000", "M000"],
          "read_config": "/cgi-bin/get_miner_conf.cgi",
          "config_fields": {"pools": "pools", "bitmain-fan-ctrl": "bitmain-fan-ctrl", "bitmain-fan-pwm": "bitmain-fan-pwm", "bitmain-hashrate-percent": "bitmain-hashrate-percent", "bitmain-user-ip-cat": "bitmain-user-ip-cat"},
          "payload": {"miner-mode": 0},
          "verify": {"path": "/cgi-bin/get_miner_conf.cgi", "field": ["bitmain-work-mode"], "equals": "0"}
        }
      }
